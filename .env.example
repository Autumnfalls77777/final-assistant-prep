# JARVIS backend configuration
# Copy this file to .env and adjust non-secret values as needed.
# Never commit the real .env file.

APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=UTC
API_HOST=127.0.0.1
API_PORT=8000
AUDIT_LOG_PATH=var/audit.jsonl

# Phase 2 - model routing
DEFAULT_MODEL_PROVIDER=gemini
LOCAL_FALLBACK_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_API_KEY=
MODEL_TIMEOUT_SECONDS=60
MAX_TOOL_ITERATIONS=3
MAX_TOOL_CALLS_PER_TURN=8

# Phase 2/4 - local usage meter
USAGE_DB_PATH=var/usage.db
LOCAL_DAILY_TOKEN_BUDGET=1000000

# Phase 3 - local memory
MEMORY_DB_PATH=var/jarvis.db
MEMORY_MAX_RESULTS=5
MEMORY_MIN_SCORE=0.12
MEMORY_RETENTION_DAYS=365
MEMORY_WORKING_TTL_HOURS=24
MEMORY_CONTEXT_MAX_CHARS=4000
MEMORY_AUTO_STORE_CHAT=true

# Reserved for later phases.
REMOTE_ACCESS_ENABLED=false
WAKE_WORD_ENABLED=false
